# Supabase (client Vite — préfixe VITE_)
VITE_SUPABASE_URL=http://127.0.0.1:15431
VITE_SUPABASE_ANON_KEY=
VITE_DEFAULT_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001

# Chatbot Richard (serveur Vite — sans préfixe VITE_)
# Clé Cursor (prioritaire) : https://cursor.com/dashboard/integrations
CURSOR_API_KEY=
# Modèle Cursor optionnel (défaut : composer-2.5)
CURSOR_MODEL=composer-2.5

# Repli OpenAI si CURSOR_API_KEY absente : https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Supabase serveur (lecture seule Richard — ne pas exposer la service role au client)
SUPABASE_URL=http://127.0.0.1:15431
SUPABASE_SERVICE_ROLE_KEY=
# Repli si pas de service role (moins permissif selon RLS)
SUPABASE_ANON_KEY=
